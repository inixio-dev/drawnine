{
  "name": "drawnine",
  "version": "0.1.0",
  "description": "MTG proxy generator (printable A4 PDF) for personal deck playtesting only",
  "keywords": [
    "mtg",
    "magic-the-gathering",
    "proxy",
    "playtesting",
    "scryfall",
    "pdf",
    "decklist",
    "cli"
  ],
  "author": "inixio-dev (https://github.com/inixio-dev)",
  "license": "MIT",
  "homepage": "https://github.com/inixio-dev/drawnine#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inixio-dev/drawnine.git"
  },
  "bugs": {
    "url": "https://github.com/inixio-dev/drawnine/issues"
  },
  "type": "module",
  "bin": {
    "drawnine": "dist/apps/cli/apps/cli/src/main.js"
  },
  "files": [
    "dist/apps/cli",
    "!**/*.map",
    "!**/*.d.ts",
    "!**/*.tsbuildinfo",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nest build api && nest build cli",
    "format": "prettier --write \"{apps,libs}/**/*.ts\" \"*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/apps/api/apps/api/src/main.js",
    "lint": "oxlint --type-aware apps/ libs/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "prepublishOnly": "pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1175.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "fflate": "^0.8.3",
    "nest-commander": "^3.21.0",
    "pdf-lib": "^1.17.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@swc/core": "^1.16.22",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^4.1.2"
  }
}
