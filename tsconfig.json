{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "noImplicitOverride": true,
    "types": ["node", "multer"],
    "paths": {
      "@app/core": ["./libs/core/src/index.ts"],
      "@app/decklist-parser": ["./libs/decklist-parser/src/index.ts"],
      "@app/pdf-renderer": ["./libs/pdf-renderer/src/index.ts"],
      "@app/scryfall-client": ["./libs/scryfall-client/src/index.ts"],
      "@app/assets": ["./libs/assets/src/index.ts"],
      "@app/storage": ["./libs/storage/src/index.ts"]
    }
  },
  "include": ["apps", "libs", "*.config.ts", "vitest.config.e2e.ts"],
  "exclude": ["node_modules", "dist"]
}
