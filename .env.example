# HTTP port for the API
PORT=3000

# Scryfall requires a descriptive User-Agent (https://scryfall.com/docs/api).
# Defaults to "DrawNine/<version> (+https://github.com/inixio-dev/drawnine)"
# SCRYFALL_USER_AGENT=
SCRYFALL_BASE_URL=https://api.scryfall.com

# Storage used for the Scryfall cache: "disk" or "s3"
STORAGE_DRIVER=disk
# Root folder for the disk driver. The CLI defaults to ~/.cache/drawnine
STORAGE_DISK_ROOT=./.cache/drawnine

# Limits for uploaded art .zip files
# Set ART_ZIP_MAX_COMPRESSED_BYTES=0 to accept .zip files of any size (the
# uncompressed and entry limits still apply as zip-bomb protection). The CLI
# defaults to 0 (local files); the API defaults to 50 MB when unset
ART_ZIP_MAX_COMPRESSED_BYTES=0
ART_ZIP_MAX_UNCOMPRESSED_BYTES=0
ART_ZIP_MAX_ENTRIES=500

# Storage driver "s3" (credentials from the default AWS provider chain)
# STORAGE_DRIVER=s3
# S3_BUCKET=drawnine-cache
# S3_PREFIX=cache
# S3_REGION=eu-west-1
# S3_ENDPOINT=http://localhost:9000   # MinIO / R2 / other S3-compatible
# S3_FORCE_PATH_STYLE=true

# Maximum printed cards (faces) per request
PROXY_MAX_CARDS=600
